# usage: cmake -DSIM=<exe> -DOUT=<dir> -P occlusion_check.cmake
# (1) 壁のないシナリオ(crossing)では --occlusion の on / off で trace が一致する(tracker あり・なし)
# (2) --blind-csv は 1 走行 1 行・16 列。blind_corner シード 2 で、on は t_first_los > 0、安全停止の初回時刻が off と違う
file(MAKE_DIRECTORY ${OUT})
foreach(tr "" "--use-tracker")
  string(REPLACE "-" "" tag "x${tr}")
  set(COMMON --scenario crossing --seeds 1 --seed-start 1 --sim-time 15 ${tr})
  execute_process(COMMAND ${SIM} ${COMMON} --trace ${OUT}/off_${tag}.txt RESULT_VARIABLE r1 OUTPUT_QUIET ERROR_QUIET)
  execute_process(COMMAND ${SIM} ${COMMON} --occlusion --trace ${OUT}/on_${tag}.txt RESULT_VARIABLE r2 OUTPUT_QUIET ERROR_QUIET)
  if(NOT r1 EQUAL 0 OR NOT r2 EQUAL 0)
    message(FATAL_ERROR "sim run failed: ${r1} ${r2}")
  endif()
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/off_${tag}.txt ${OUT}/on_${tag}.txt RESULT_VARIABLE same)
  if(NOT same EQUAL 0)
    message(FATAL_ERROR "--occlusion changes the trace of a wall-free scenario (${tr})")
  endif()
endforeach()

set(B --scenario blind_corner --seeds 1 --seed-start 2)
execute_process(COMMAND ${SIM} ${B} --occlusion --blind-csv ${OUT}/on.csv RESULT_VARIABLE r1 OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND ${SIM} ${B} --blind-csv ${OUT}/off.csv RESULT_VARIABLE r2 OUTPUT_QUIET ERROR_QUIET)
if(NOT r1 EQUAL 0 OR NOT r2 EQUAL 0)
  message(FATAL_ERROR "blind run failed: ${r1} ${r2}")
endif()
file(STRINGS ${OUT}/on.csv on_lines)
file(STRINGS ${OUT}/off.csv off_lines)
list(LENGTH on_lines n_on)
if(NOT n_on EQUAL 2)
  message(FATAL_ERROR "blind csv should have a header and one row, got ${n_on} lines")
endif()
list(GET on_lines 0 head)
list(GET on_lines 1 on_row)
list(GET off_lines 1 off_row)
string(REPLACE "," ";" head_f "${head}")
string(REPLACE "," ";" on_f "${on_row}")
string(REPLACE "," ";" off_f "${off_row}")
list(LENGTH head_f n_head)
list(LENGTH on_f n_on_f)
if(NOT n_head EQUAL 16 OR NOT n_on_f EQUAL 16)
  message(FATAL_ERROR "blind csv should have 16 columns: ${n_head} / ${n_on_f}")
endif()
list(GET on_f 6 t_los)
if(NOT t_los GREATER 0)
  message(FATAL_ERROR "t_first_los should be > 0 (got ${t_los})")
endif()
list(GET on_f 11 ss_on)
list(GET off_f 11 ss_off)
if(ss_on STREQUAL ss_off)
  message(FATAL_ERROR "occlusion did not change the first safety stop time (${ss_on})")
endif()
