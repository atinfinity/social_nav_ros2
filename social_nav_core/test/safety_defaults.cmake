# usage: cmake -DSIM=<exe> -DOUT=<dir> -P safety_defaults.cmake
# --safety-mode predictive と --diag-ped-robot-vel applied の明示は無指定と同じ trace になり、
# cm / cm_stop / off / cmd は(corridor_oncoming で)trace が変わることを確かめる。
file(MAKE_DIRECTORY ${OUT})
set(COMMON --scenario corridor_oncoming --seeds 1 --seed-start 1 --sim-time 20)
function(run name)
  execute_process(COMMAND ${SIM} ${COMMON} ${ARGN} --trace ${OUT}/t_${name}.txt RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "sim run failed (${name}): ${rc}")
  endif()
endfunction()
run(none)
run(default --safety-mode predictive --diag-ped-robot-vel applied)
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/t_none.txt ${OUT}/t_default.txt RESULT_VARIABLE same)
if(NOT same EQUAL 0)
  message(FATAL_ERROR "explicit default values change the trace")
endif()
run(cm --safety-mode cm)
run(cm_stop --safety-mode cm_stop)
run(off --safety-mode off)
foreach(n cm cm_stop off)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/t_none.txt ${OUT}/t_${n}.txt RESULT_VARIABLE d)
  if(d EQUAL 0)
    message(FATAL_ERROR "--safety-mode ${n} had no effect")
  endif()
endforeach()
