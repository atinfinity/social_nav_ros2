# usage: cmake -DSIM=<exe> -DOUT=<dir> -P speed_mix_defaults.cmake
# --ped-speed-mix off の明示は無指定と同じ trace(crowd)。on は変わる。on でも対象外の overtake は off と同じ trace。
file(MAKE_DIRECTORY ${OUT})
set(COMMON --seeds 1 --seed-start 1 --sim-time 15)
execute_process(COMMAND ${SIM} --scenario crowd ${COMMON} --trace ${OUT}/c_none.txt RESULT_VARIABLE r1 OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND ${SIM} --scenario crowd ${COMMON} --ped-speed-mix off --trace ${OUT}/c_off.txt RESULT_VARIABLE r2 OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND ${SIM} --scenario crowd ${COMMON} --ped-speed-mix on --trace ${OUT}/c_on.txt RESULT_VARIABLE r3 OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND ${SIM} --scenario overtake ${COMMON} --trace ${OUT}/o_none.txt RESULT_VARIABLE r4 OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND ${SIM} --scenario overtake ${COMMON} --ped-speed-mix on --trace ${OUT}/o_on.txt RESULT_VARIABLE r5 OUTPUT_QUIET ERROR_QUIET)
foreach(r ${r1} ${r2} ${r3} ${r4} ${r5})
  if(NOT r EQUAL 0)
    message(FATAL_ERROR "sim run failed")
  endif()
endforeach()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/c_none.txt ${OUT}/c_off.txt RESULT_VARIABLE same)
if(NOT same EQUAL 0)
  message(FATAL_ERROR "--ped-speed-mix off changes the trace")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/c_none.txt ${OUT}/c_on.txt RESULT_VARIABLE diff)
if(diff EQUAL 0)
  message(FATAL_ERROR "--ped-speed-mix on had no effect on crowd")
endif()
execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files ${OUT}/o_none.txt ${OUT}/o_on.txt RESULT_VARIABLE same2)
if(NOT same2 EQUAL 0)
  message(FATAL_ERROR "--ped-speed-mix on changed a non-target scenario (overtake)")
endif()
